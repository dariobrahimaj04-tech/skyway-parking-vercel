{
  "name": "skyway-parking-vercel",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node -e \"const fs=require('fs');fs.rmSync('dist',{recursive:true,force:true});fs.mkdirSync('dist',{recursive:true});for(const file of ['index.html','styles.css','script.js'])fs.copyFileSync(file,'dist/'+file);if(fs.existsSync('assets'))fs.cpSync('assets','dist/assets',{recursive:true});\"",
    "preview": "vite preview"
  },
  "devDependencies": {
    "vite": "^5.0.0"
  }
}
